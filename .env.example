# کپی کن به .env و پرش کن. این فایل نمونه است، کلید واقعی اینجا ننویس.
# TOKEN_HARBOR_API_KEY و LLM_BASE_URL را از پنل توکن هاربور کپی کن.
TOKEN_HARBOR_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# از سایت Tavily بگیر (نسخه رایگان)
TAVILY_API_KEY=

# از سایت LangSmith بگیر (نسخه رایگان) — برای eval اختیاری است
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=vehicle-maintenance-workflow

# مدیریت توکن
MAX_TOKENS=4000
KEEP_LAST_MESSAGES=4
